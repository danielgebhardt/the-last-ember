{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -p tsconfig.app.json --incremental false && tsc -p tsconfig.node.json --incremental false",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"ci": "biome ci .",
		"test:smoke": "pnpm build && playwright test"
	},
	"packageManager": "pnpm@11.25.0",
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@dnd-kit/core": "6.3.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"lucide-react": "^1.53.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.21.4",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@playwright/test": "1.64.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
